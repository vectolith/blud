{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build:app": {
      "dependsOn": [
        "^build:app"
      ],
      "env": [
        "BETTER_AUTH_*",
        "BLOB_*",
        "BLUD_INTERNAL_KEY",
        "VELNOR_SHARED_SECRET",
        "DATABASE_URL",
        "EVE_NEXT_*",
        "*_CONNECTOR_UID",
        "KERNEL_*",
        "LINQ_*",
        "LINK_*",
        "STRIPE_PUBLISHABLE_KEY",
        "NODE_ENV",
        "SECRET_ENCRYPTION_KEY",
        "VERCEL_*",
        "BLUD_INTERNAL_KEY",
        "VELNOR_SHARED_SECRET"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "next-env.d.ts"
      ]
    },
    "build:vercel": {
      "dependsOn": [
        "db:migrate"
      ],
      "env": [
        "BETTER_AUTH_*",
        "BLOB_*",
        "BLUD_INTERNAL_KEY",
        "VELNOR_SHARED_SECRET",
        "DATABASE_URL",
        "*_CONNECTOR_UID",
        "KERNEL_*",
        "LINQ_*",
        "LINK_*",
        "STRIPE_PUBLISHABLE_KEY",
        "NODE_ENV",
        "SECRET_ENCRYPTION_KEY",
        "VERCEL_*",
        "BLUD_INTERNAL_KEY",
        "VELNOR_SHARED_SECRET"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "next-env.d.ts"
      ]
    },
    "db:migrate": {
      "cache": false,
      "env": [
        "DATABASE_URL_UNPOOLED"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ]
    },
    "dev:app": {
      "cache": false,
      "passThroughEnv": [
        "BETTER_AUTH_*",
        "BLOB_*",
        "BLUD_INTERNAL_KEY",
        "VELNOR_SHARED_SECRET",
        "DATABASE_URL",
        "*_CONNECTOR_UID",
        "KERNEL_*",
        "LINQ_*",
        "LINK_*",
        "STRIPE_PUBLISHABLE_KEY",
        "NODE_ENV",
        "SECRET_ENCRYPTION_KEY",
        "VERCEL_*",
        "BLUD_INTERNAL_KEY",
        "VELNOR_SHARED_SECRET"
      ],
      "persistent": true
    },
    "deploy:app": {
      "cache": false
    },
    "format:check": {
      "outputs": []
    },
    "knip": {
      "outputs": []
    },
    "lint:app": {
      "outputs": [],
      "env": [
        "BLUD_INTERNAL_KEY",
        "VELNOR_SHARED_SECRET"
      ]
    },
    "start:app": {
      "cache": false,
      "passThroughEnv": [
        "BETTER_AUTH_*",
        "BLOB_*",
        "BLUD_INTERNAL_KEY",
        "VELNOR_SHARED_SECRET",
        "DATABASE_URL",
        "*_CONNECTOR_UID",
        "KERNEL_*",
        "LINQ_*",
        "LINK_*",
        "STRIPE_PUBLISHABLE_KEY",
        "NODE_ENV",
        "SECRET_ENCRYPTION_KEY",
        "VERCEL_*",
        "BLUD_INTERNAL_KEY",
        "VELNOR_SHARED_SECRET"
      ],
      "persistent": true
    },
    "test:app": {
      "outputs": [],
      "env": [
        "BLUD_INTERNAL_KEY",
        "VELNOR_SHARED_SECRET"
      ]
    },
    "types:generate": {
      "outputs": [
        ".next/types/**",
        "next-env.d.ts"
      ]
    },
    "types:check:app": {
      "dependsOn": [
        "types:generate"
      ],
      "outputs": [
        "*.tsbuildinfo"
      ]
    }
  }
}
