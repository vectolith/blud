# Internal RPC authentication. Leave unset to disable the legacy browser-worker route.
# In production it also authenticates the scheduler callbacks; generate with
# openssl rand -base64 48.
BLUD_INTERNAL_KEY=
# Optional overrides. A deployment that leaves these unset stores the generated
# pair in the object store under BLUD_INSTALLATION_ID.
BETTER_AUTH_SECRET=
# The public origin of this deployment, e.g. https://blud.onrender.com
BETTER_AUTH_URL=
# Stable identifier for this installation, used to namespace stored secrets.
BLUD_INSTALLATION_ID=
# Postgres connection string. `pnpm dev` overrides both with the local Docker
# Compose database.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/blud
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@127.0.0.1:54329/blud
# Active base64-encoded 32-byte key. Generate with: openssl rand -base64 32
SECRET_ENCRYPTION_KEY=
# Keep the default until a coordinated key rotation is performed.
SECRET_ENCRYPTION_KEY_VERSION=installation-v1
# During rotation, map every historical version to its base64-encoded key.
# Example: {"installation-v1":"<previous-base64-key>"}
SECRET_ENCRYPTION_KEYRING=
# Required for browser execution. Create a key at https://kernel.sh.
KERNEL_API_KEY=
# Required for model inference.
AI_GATEWAY_API_KEY=
# S3-compatible object storage for installation secrets, browser-image
# artifacts, and agent memory. Works with AWS S3, Cloudflare R2, Backblaze B2,
# Wasabi, or MinIO. S3_FORCE_PATH_STYLE defaults to true; set it to false for
# virtual-hosted-style buckets such as AWS S3.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Optional Google Workspace connector identifier (Vercel Connect).
GOOGLE_CONNECTOR_UID=
# Sendblue credentials for iMessage/SMS delivery. The webhook secret verifies
# inbound requests; the from-number is the line Blud messages from.
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
SENDBLUE_FROM_NUMBER=
SENDBLUE_WEBHOOK_SECRET=
# Optional GitHub App user authorization. Keep the client secret server-side.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Optional per-user Link wallet connection. Register the exact callback URL
# https://<BETTER_AUTH_URL host>/api/auth/callback/link with Stripe.
LINK_CLIENT_ID=
LINK_CLIENT_SECRET=
STRIPE_PUBLISHABLE_KEY=
# Development benchmarks only (pnpm bench:browser).
BROWSER_BENCH_LABEL=self-hosted
BROWSER_BENCH_REPETITIONS=1
